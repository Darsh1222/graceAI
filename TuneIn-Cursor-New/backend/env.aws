SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNqcW1uem5pcGp3ZHhncWRlZ292Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NDUwNDk3MSwiZXhwIjoyMDcwMDgwOTcxfQ.zwlQy4FzGL0bfPMG04-qDA1iK3RiJ-gJYCJq8TcPd8w
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=508426718674

# Database Configuration (if using RDS instead of Supabase)
# DATABASE_URL=postgresql://username:password@host:port/database

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_FOLDER=/tmp/uploads
GENERATED_FILES_FOLDER=/tmp/generated_files

# Analysis Pipeline Configuration
ENABLE_ANALYSIS_PIPELINE=true
ANALYSIS_TIMEOUT=300  # 5 minutes
MAX_CONCURRENT_ANALYSES=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# Monitoring Configuration
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
METRICS_ENDPOINT=/metrics

# Cache Configuration
ENABLE_CACHE=true
CACHE_TTL=3600  # 1 hour
REDIS_URL=redis://localhost:6379  # if using Redis

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900  # 15 minutes

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ENABLE_EMAIL_NOTIFICATIONS=false
