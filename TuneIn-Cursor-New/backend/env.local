# Local Development Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_FOLDER=./uploads
GENERATED_FILES_FOLDER=./generated_files

# Analysis Pipeline Configuration
ENABLE_ANALYSIS_PIPELINE=true
ANALYSIS_TIMEOUT=300  # 5 minutes
MAX_CONCURRENT_ANALYSES=5

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ENABLE_STRUCTURED_LOGGING=false

# Monitoring Configuration
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
METRICS_ENDPOINT=/metrics

# Cache Configuration
ENABLE_CACHE=false
CACHE_TTL=3600  # 1 hour

# Rate Limiting
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=900  # 15 minutes

# Email Configuration (disabled for local)
ENABLE_EMAIL_NOTIFICATIONS=false
